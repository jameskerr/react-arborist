{
  "name": "react-arborist",
  "version": "4.0.1",
  "keywords": [
    "arborist",
    "dnd",
    "filterable",
    "multiselection",
    "react",
    "react-arborist",
    "tree",
    "treeview",
    "virtualized"
  ],
  "homepage": "https://react-arborist.netlify.app",
  "bugs": "https://github.com/jameskerr/react-arborist/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jameskerr/react-arborist.git"
  },
  "source": "src/index.ts",
  "files": [
    "src",
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "dist/module/index.js",
  "module": "dist/module/index.js",
  "types": "dist/module/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/module/index.d.ts",
      "default": "./dist/module/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rimraf dist && tsc",
    "clean": "rimraf dist",
    "prepack": "yarn build",
    "test": "jest",
    "watch": "tsc --watch"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/utilities": "^3.2.2",
    "@types/react-window": "^1.8.8",
    "react-window": "^1.8.11",
    "redux": "^5.0.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^9.3.0",
    "@testing-library/react": "^14.0.0",
    "@types/jest": "^29.5.11",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "npm-run-all": "^4.1.5",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "rimraf": "^5.0.5",
    "ts-jest": "^29.4.0",
    "typescript": "^5.6.0"
  },
  "peerDependencies": {
    "react": ">= 18",
    "react-dom": ">= 18"
  },
  "engines": {
    "node": ">=22.12"
  }
}
